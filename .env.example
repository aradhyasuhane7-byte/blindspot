# ============================================================
# Blindspot - environment configuration (copy to .env; never commit .env)
#
# PowerShell:
#   Copy-Item .env.example .env   (edit values)
#   npm start
# ============================================================

# --- Firebase project id (informational) ---
FB_PROJECT_ID=your-firebase-project-id

# --- Firebase WEB configuration (public values from Project settings > Your apps) ---
# These are rendered into the login page; they are NOT server secrets.
FB_WEB_API_KEY=AIza...your-web-api-key...
FB_WEB_AUTH_DOMAIN=your-firebase-project-id.firebaseapp.com
FB_WEB_PROJECT_ID=your-firebase-project-id
FB_WEB_APP_ID=1:123456789012:web:abcdef123456

# --- Firebase Admin credentials for the Node backend ---
# Path to the service-account JSON file. NEVER commit it or serve it to the browser.
BLINDSPOT_FIREBASE_CREDENTIALS=./secrets/blindspot-service-account.json

# --- Session secret & production switches ---
SESSION_SECRET=change-me-to-a-long-random-string
# Set to true only in production behind HTTPS
SESSION_SECURE=false
TRUST_PROXY=false

# --- One-time bootstrap of the FIRST ADMIN (remove after first run!) ---
# Create the user in Firebase Auth console (Email/Password), then either
# paste its UID here (recommended) or just the email to look it up by email.
BLINDSPOT_SETUP_ADMIN_UID=PASTE_FIREBASE_AUTH_UID_HERE
BLINDSPOT_SETUP_ADMIN_EMAIL=

# --- Demo mode (optional) ---
# true = on server start (with Firebase configured), create 5 demo accounts
# (password demo1234) and 16 demo packages when they don't exist yet.
# Set to false for production!
BLINDSPOT_AUTO_SEED_DEMO=false

# --- Server ---
PORT=8080
