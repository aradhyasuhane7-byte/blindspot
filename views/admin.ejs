<%- include('partials/head') %>
<body class="app">
  <%- include('partials/sidebar', { me: me, navKind: 'admin', active: 'overview' }) %>

  <div class="main">
    <header class="topbar">
      <button class="hamburger" id="hamburger" aria-label="Open menu" aria-controls="sidebar" aria-expanded="false">&#9776;</button>
      <h1 class="topbar-title" id="page-title">Admin Overview</h1>
      <div class="topbar-actions"><span class="chip chip-blue">Administrator</span></div>
    </header>

    <main class="content">
      <div class="notice" id="denied-banner" hidden>You do not have permission for the page you tried to open.</div>

      <section class="summary-grid" id="admin-summary" aria-label="Admin summary">
        <div class="card stat"><span class="stat-dot neutral"></span><div><span class="stat-value" id="a-total">-</span><span class="stat-label">Total packages</span></div></div>
        <div class="card stat"><span class="stat-dot progress"></span><div><span class="stat-value" id="a-active">-</span><span class="stat-label">Active packages</span></div></div>
        <div class="card stat"><span class="stat-dot delayed"></span><div><span class="stat-value" id="a-delayed">-</span><span class="stat-label">Delayed packages</span></div></div>
        <div class="card stat"><span class="stat-dot delivered"></span><div><span class="stat-value" id="a-delivered">-</span><span class="stat-label">Delivered packages</span></div></div>
        <div class="card stat"><span class="stat-dot progress"></span><div><span class="stat-value" id="a-employees">-</span><span class="stat-label">Employees</span></div></div>
        <div class="card stat"><span class="stat-dot pending"></span><div><span class="stat-value" id="a-attention">-</span><span class="stat-label">Needed attention</span></div></div>
      </section>

      <p class="footer-note">
        Use the sidebar to open a workflow (Confirmation, Packaging, Documentation/Dispatch,
        Delivery), manage <a href="/admin/employees">Employees</a> or view
        <a href="/reports">Reports</a>.
      </p>
    </main>
  </div>

  <div id="toast-stack" class="toast-stack" aria-live="polite"></div>

  <script>
    window.__PAGE__ = 'admin';
    <% if (typeof denied !== 'undefined' && denied) { %>document.getElementById('denied-banner').hidden = false;<% } %>
  </script>
  <script src="/js/workflow.js?v=5" defer></script>
</body>
</html>
