<%- include('partials/head') %>
<body class="app">
  <%- include('partials/sidebar', {
    me: me,
    navKind: (me && me.role === 'ADMIN') ? 'admin' : 'employee',
    active: page,
    homeUrl: ({ CONFIRM: '/confirm', PACK: '/pack', DOC: '/doc', DEL: '/del' })[me.role],
    homeLabel: page === 'confirm' ? 'Confirmation' : page === 'pack' ? 'Packaging' : page === 'doc' ? 'Documentation/Dispatch' : 'Delivery'
  }) %>

  <div class="main">
    <header class="topbar">
      <button class="hamburger" id="hamburger" aria-label="Open menu" aria-controls="sidebar" aria-expanded="false">&#9776;</button>
      <h1 class="topbar-title" id="page-title"><%= heading %></h1>
      <div class="topbar-actions">
        <span class="chip chip-graded"><%= heading %></span>
      </div>
    </header>

    <main class="content">
      <% if (typeof denied !== 'undefined' && denied) { %>
        <div class="notice warn" id="denied-banner">You do not have permission for the page you tried to open.</div>
      <% } %>

      <% if (me.role === 'CONFIRM') { %>
        <section class="card create-card">
          <div class="card-head">
            <h2 class="card-title">Create a new package</h2>
            <button class="btn btn-primary" id="open-create" type="button">+ Create Package</button>
          </div>
          <p class="muted">New packages always start at the Confirmation stage with status Pending.</p>
        </section>
      <% } %>

      <section class="card">
        <div class="stage-tabs" id="view-tabs" role="tablist" aria-label="Package views">
          <% for (const [key, label] of viewsForPage) { %>
            <button class="tab <%= key === defaultView ? 'active' : '' %>" type="button" role="tab" aria-selected="<%= key === defaultView %>" data-view="<%= key %>"><%= label %></button>
          <% } %>
        </div>
        <form class="work-filters" onsubmit="return false;">
          <label class="field grow"><span class="label">Search</span>
            <input class="input" type="search" id="work-q" placeholder="Package ID, project, customer...">
          </label>
          <button class="btn btn-outline" id="work-refresh" type="button">Refresh</button>
        </form>
        <div class="table-wrap">
          <table class="table">
            <thead><tr id="work-head"></tr></thead>
            <tbody id="work-body">
              <tr class="state-row"><td colspan="6"><span class="muted">Loading...</span></td></tr>
            </tbody>
          </table>
        </div>
        <div class="empty-state" id="work-empty" hidden><p><strong>Nothing here yet.</strong><br><span class="muted">No packages match this view.</span></p></div>
        <div class="error-state" id="work-error" hidden><p><strong>Could not load packages.</strong></p><p class="muted" id="work-error-detail"></p><button class="btn btn-outline btn-sm" id="work-retry" type="button">Retry</button></div>
      </section>
    </main>
  </div>

  <% if (me.role === 'CONFIRM') { %>
  <div class="modal-backdrop" id="create-modal" hidden>
    <div class="modal" role="dialog" aria-modal="true" aria-labelledby="create-title">
      <div class="modal-head"><h2 id="create-title">Create Package</h2><button class="modal-x" data-close="create-modal" type="button" aria-label="Close">&#10005;</button></div>
      <div class="modal-body">
        <form id="create-form" novalidate>
          <div class="grid-2">
            <label class="field"><span class="label">Package ID <span class="req">*</span></span><input class="input" id="c-code" placeholder="e.g. PK-2026-0001"><span class="error-text" data-err="packageCode" hidden></span></label>
            <label class="field"><span class="label">Project Name <span class="req">*</span></span><input class="input" id="c-project" maxlength="120"><span class="error-text" data-err="projectName" hidden></span></label>
            <label class="field"><span class="label">Customer Name <span class="req">*</span></span><input class="input" id="c-customer" maxlength="120"><span class="error-text" data-err="customerName" hidden></span></label>
            <label class="field"><span class="label">Order Reference</span><input class="input" id="c-order-ref" maxlength="120"></label>
            <label class="field"><span class="label">Confirmation Date</span><input class="input" type="date" id="c-confirm-date"></label>
            <label class="field"><span class="label">Expected Delivery Date</span><input class="input" type="date" id="c-expected"></label>
          </div>
          <label class="field"><span class="label">Order Details</span><textarea class="input" id="c-order-details" rows="3" maxlength="2000" placeholder="Internal only - never shown on the public dashboard"></textarea></label>
          <label class="field"><span class="label">Initial Remarks</span><textarea class="input" id="c-remarks" rows="2" maxlength="2000"></textarea></label>
          <label class="check-row"><input type="checkbox" id="c-public"> <span>Approve customer name for public dashboard display</span></label>
          <p class="muted">Fields marked <span class="req">*</span> are required. Unique Package ID required.</p>
        </form>
        <div class="error-text" id="create-error" hidden></div>
      </div>
      <div class="modal-foot">
        <button class="btn btn-outline" data-close="create-modal" type="button">Cancel</button>
        <button class="btn btn-primary" id="create-submit" type="button">Create Package</button>
      </div>
    </div>
  </div>
  <% } %>

  <div class="modal-backdrop" id="pkg-modal" hidden>
    <div class="modal" role="dialog" aria-modal="true" aria-labelledby="pkg-title">
      <div class="modal-head"><h2 id="pkg-title">Package</h2><button class="modal-x" data-close="pkg-modal" type="button" aria-label="Close">&#10005;</button></div>
      <div class="modal-body" id="pkg-body"></div>
      <div class="modal-foot" id="pkg-foot"></div>
    </div>
  </div>

  <div id="toast-stack" class="toast-stack" aria-live="polite"></div>

  <script>window.__PAGE__ = '<%= page %>';</script>
  <script src="/js/workflow.js?v=5" defer></script>
</body>
</html>
